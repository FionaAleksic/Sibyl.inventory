{
  "schemaVersion": 1,
  "id": "Sibyl.inventory",
  "version": "0.1.0-rc.3",
  "name": "Inventar",
  "description": "IPAM-Vollansicht und ICMP-basierte Zustandsmodelle; Adapter zu bestehenden Inventar- und AD-Datenquellen in Vorbereitung.",
  "type": "feature",
  "runtime": "java21-jar",
  "entrypoint": "org.sibyl.addons.inventory.InventorySnapshot",
  "apiCompatibility": ">=0.1.0 <1.0.0",
  "capabilities": [
    "inventory.ipam.read",
    "inventory.host-status.evaluate"
  ],
  "requires": [
    {
      "id": "Sibyl.core",
      "version": ">=0.1.0"
    },
    {
      "id": "Sibyl.ad",
      "version": ">=0.1.0-rc.3"
    }
  ],
  "configurationSchema": "config.schema.json",
  "repository": "FionaAleksic/Sibyl.inventory",
  "releaseChannel": "prerelease",
  "license": "MIT",
  "deployment": "deployment.json"
}
